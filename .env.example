DB_HOST=localhost
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=ffa_timing
DB_PORT=3306

# Génère un secret fort (>= 32 bytes), ex:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=CHANGE_ME

# Liste blanche CORS (séparée par virgules, sans slash final)
# Obligatoire en production — sinon le login front est bloqué (OPTIONS 403)
# CORS_ORIGINS=https://timing.ffaviron.fr,http://localhost:5173
# FRONTEND_URL=https://timing.ffaviron.fr

# Derrière Coolify / reverse proxy (1 = hop unique). Mettre false en local pur.
# TRUST_PROXY=1

# Durées recommandées
ACCESS_TOKEN_EXPIRES_IN=30m
TIMING_POINT_TOKEN_EXPIRES_IN=24h

